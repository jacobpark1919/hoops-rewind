# Client-side (safe to expose in browser builds)
VITE_SUPABASE_URL=REPLACE_ME
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_ME

# Server-only (NEVER expose in client code)
# These are set as Lovable Cloud secrets, not in .env
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
# ADMIN_PASSWORD=REPLACE_ME
ALLOWED_ORIGIN=https://yourdomain.com
